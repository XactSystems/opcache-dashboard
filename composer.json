{
    "name": "xactsystems/opcache-dashboard",
    "description": "OPCache Dashboard for Symfony",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Ian Foulds",
            "email": "ianfoulds@x-act.co.uk"
        }
    ],
    "autoload": {
        "psr-4": {
            "Xact\\OPCacheDashboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xact\\OPCacheDashboard\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "symfony/twig-bundle": "6.4|^7.1",
        "twig/twig": "^3.11",
        "williarin/cook": "^1.3"
    },
    "require-dev": {
        "symfony/debug-pack": "*",
        "symfony/test-pack": "*"
    },
    "config": {
        "allow-plugins": {
            "williarin/cook": true
        }
    }
}
